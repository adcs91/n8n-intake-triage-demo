    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body ?? $json;\nconst text = String(b.message ?? '');\nreturn { json: {\n  name: b.name ?? 'unknown',\n  email: b.email ?? 'unknown',\n  message: text,\n  qty: b.qty ?? null,\n  deadline: b.deadline ?? null,\n  received_at: new Date().toISOString(),\n} };"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "2 - Parse Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -340,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTriesMs": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = String($json.message).toLowerCase();\nconst price = /price|quote|cost|how much/.test(m);\nconst spec = /spec|datasheet|drawing|cad/.test(m);\nconst lead = /lead time|delivery|when can|eta/.test(m);\nconst stock = /in stock|available|stock/.test(m);\nconst hits = [price, spec, lead, stock].filter(Boolean).length;\nconst tier = hits >= 3 ? 'A' : hits >= 1 ? 'B' : 'C';\nconst reason = hits >= 3\n  ? 'multi-question inquiry: price + spec + lead time + stock'\n  : hits >= 1 ? 'single-question inquiry' : 'no commercial intent detected';\nreturn { json: { ...$json, hits, tier, reason } };"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "3 - Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
